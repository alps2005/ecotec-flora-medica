---
import logoEcotec from "../assets/logo-ecotec-2025-transparente.webp";
import isotipoSamborondon from "../assets/isotipo-samborondon.webp";
import isotipoGuayaquil from "../assets/isotipo-guayaquil.webp";
import isotipoCosta from "../assets/isotipo-costa.webp";
---

<footer class="border-t border-slate-200 bg-white py-12 px-6 sm:px-8 lg:px-12">
  <div
    class="max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-center lg:items-start gap-12 lg:gap-8"
  >
    <!-- Left Column: Logo & Admissions -->
    <div
      class="flex flex-col items-center lg:items-start text-center lg:text-left space-y-6"
    >
      <!-- ECOTEC Logo -->
      <a
        href="https://ecotec.edu.ec/"
        target="_blank"
        rel="noopener"
        class="block"
      >
        <img
          src={logoEcotec.src}
          alt="Universidad ECOTEC Logo"
          width="220"
          height="65"
          class="h-auto w-48 sm:w-56"
        />
      </a>

      <!-- Explora, Lidera, Transforma -->
      <div
        class="flex items-center justify-center lg:justify-start gap-2.5 font-sans font-black uppercase text-[10px] tracking-wider text-[#403f2b]"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#27B5E6] flex-shrink-0"
        ></span>
        <span>Explora</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#27B5E6] flex-shrink-0"
        ></span>
        <span>Lidera</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#27B5E6] flex-shrink-0"
        ></span>
        <span>Transforma</span>
      </div>

      <!-- Admissions Section -->
      <div class="space-y-2">
        <div
          class="text-[11px] font-extrabold tracking-widest text-[#403f2b] uppercase"
        >
          ADMISIONES
        </div>
        <div class="flex items-center justify-center lg:justify-start">
          <a
            href="https://wa.me/593989880999"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 text-sm text-[#403f2b] hover:text-[#0049A4] transition-colors font-semibold"
          >
            <!-- WhatsApp Icon (inline SVG) -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
            >
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path
                fill="currentColor"
                d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01m-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18l-3.12.82l.83-3.04l-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81c-.23-.08-.39-.12-.56.12c-.17.25-.64.81-.78.97c-.14.17-.29.19-.54.06c-.25-.12-1.05-.39-1.99-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.14-.25-.02-.38.11-.51c.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74c.59.26 1.05.41 1.41.52c.59.19 1.13.16 1.56.1c.48-.07 1.47-.6 1.67-1.18c.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28"
              ></path>
            </svg>

            <span>+593 98 988 0999</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Grid: Campus Cards -->
    <div
      class="grid grid-cols-1 sm:grid-cols-3 gap-8 lg:gap-12 w-full lg:w-auto"
    >
      <!-- Campus Samborondón -->
      <div class="flex flex-col">
        <div class="flex items-center justify-center gap-3">
          <img
            src={isotipoSamborondon.src}
            alt="Isotipo Campus Samborondón"
            width="32"
            height="40"
            class="w-8 h-auto flex-shrink-0"
          />
          <span
            class="font-sans font-bold text-[#403f2b] text-base leading-tight"
            >Campus Samborondón</span
          >
        </div>
        <div class="flex items-start justify-center gap-2 mt-3">
          <!-- Pin Icon (inline SVG) -->
          <svg
            class="w-4 h-4 text-gray-500 mt-1 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <a
            href="https://maps.app.goo.gl/Yh83efo6bvvjxecg6"
            target="_blank"
            rel="noopener"
            class="text-sm text-gray-600 hover:text-[#0049A4] transition-colors leading-normal"
          >
            Vía Samborondón KM 13.5
          </a>
        </div>
      </div>

      <!-- Campus Guayaquil -->
      <div class="flex flex-col">
        <div class="flex items-center justify-center gap-3">
          <img
            src={isotipoGuayaquil.src}
            alt="Isotipo Campus Guayaquil"
            width="32"
            height="40"
            class="w-8 h-auto flex-shrink-0"
          />
          <span
            class="font-sans font-bold text-[#403f2b] text-base leading-tight"
            >Campus Guayaquil</span
          >
        </div>
        <div class="flex items-start justify-center gap-2 mt-3">
          <!-- Pin Icon -->
          <svg
            class="w-4 h-4 text-gray-500 mt-1 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <a
            href="https://www.google.com/maps/place/Universidad+ECOTEC,+Juan+Tanca+Marengo/@-2.1502836,-79.9051049,17z/data=!3m1!4b1!4m5!3m4!1s0x902d6d7603f247fd:0xe328e6304112dcb4!8m2!3d-2.150289!4d-79.9029109"
            target="_blank"
            rel="noopener"
            class="text-sm text-gray-600 hover:text-[#0049A4] transition-colors leading-normal"
          >
            Av. Juan Tanca Marengo Km. 2
          </a>
        </div>
      </div>

      <!-- Campus La Costa -->
      <div class="flex flex-col">
        <div class="flex items-center justify-center gap-3">
          <img
            src={isotipoCosta.src}
            alt="Isotipo Campus La Costa"
            width="32"
            height="40"
            class="w-8 h-auto flex-shrink-0"
          />
          <span
            class="font-sans font-bold text-[#403f2b] text-base leading-tight"
            >Campus La Costa</span
          >
        </div>
        <div class="flex items-start justify-center gap-2 mt-3">
          <!-- Pin Icon -->
          <svg
            class="w-4 h-4 text-gray-500 mt-1 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <a
            href="https://www.google.com/maps/place/Universidad+Tecnologica+ECOTEC+(La+Costa)/@-2.1876118,-80.0178524,17z/data=!3m1!4b1!4m5!3m4!1s0x902d758a7cbeef21:0x5696a683de24622!8m2!3d-2.1876172!4d-80.0156584"
            target="_blank"
            rel="noopener"
            class="text-sm text-gray-600 hover:text-[#0049A4] transition-colors leading-normal"
          >
            Km 16.5 Vía La Costa
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
