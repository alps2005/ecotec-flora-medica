---
import Etnobotanicacard from './Etnobotanicacard.astro';
import Etnobotanicapagination from './Etnobotanicapagination.astro';
import { getSpeciesList } from '../../lib/species-source';

const { rows: activeSpecies } = await getSpeciesList();

const getCategories = (clasificacion: string, usoTradicional: string): string[] => {
  const normalized = `${clasificacion} ${usoTradicional}`.toLowerCase();
  const matched: string[] = [];
  
  if (normalized.includes('medicinal')) matched.push('MEDICINAL');
  if (normalized.includes('alimenticia') || normalized.includes('condimento')) matched.push('ALIMENTICIA');
  if (normalized.includes('estimulante')) matched.push('ESTIMULANTE');
  if (normalized.includes('aromática') || normalized.includes('aromatica')) matched.push('AROMÁTICA');
  if (normalized.includes('ritual')) matched.push('RITUAL');
  if (normalized.includes('agroecológica') || normalized.includes('agroecologica')) matched.push('AGROECOLÓGICA');
  
  if (matched.length === 0) {
    matched.push('MEDICINAL');
  }
  return matched;
};

const BADGE_MAP: Record<string, { color: string; bg: string }> = {
  MEDICINAL:     { color: 'text-primary',   bg: 'bg-primary/10' },
  RITUAL:        { color: 'text-tertiary',  bg: 'bg-secondary/15' },
  ALIMENTICIA:   { color: 'text-primary',   bg: 'bg-secondary/15' },
  ESTIMULANTE:   { color: 'text-secondary', bg: 'bg-primary/10' },
  AROMÁTICA:     { color: 'text-tertiary',  bg: 'bg-tertiary/10' },
  AGROECOLÓGICA: { color: 'text-primary',   bg: 'bg-secondary/10' },
};

const ICON_MAP: Record<string, string> = {
  MEDICINAL:     'ti-heart-plus',
  RITUAL:        'ti-sparkles',
  ALIMENTICIA:   'ti-tools-kitchen-2',
  ESTIMULANTE:   'ti-bolt',
  AROMÁTICA:     'ti-flower',
  AGROECOLÓGICA: 'ti-seeding',
};

const plantas = activeSpecies.map((especie) => {
  const clasificacion = especie.data.etnobotanica.clasificacion;
  const usoTradicional = especie.data.etnobotanica.usoTradicional;
  const matchedCategories = getCategories(clasificacion, usoTradicional);
  const primaryCategory = matchedCategories[0] ?? 'MEDICINAL';
  
  const badge = BADGE_MAP[primaryCategory] ?? { color: 'text-slate-700', bg: 'bg-slate-50' };
  const icono = ICON_MAP[primaryCategory] ?? 'ti-leaf';
  const compuestos = especie.data.compuestosQuimicos.map(c => c.nombre).join(' · ');

  return {
    nombre: especie.data.nombreComun,
    cientifico: especie.data.nombreCientifico,
    categoria: clasificacion,
    icono,
    parteUsada: especie.data.etnobotanica.parteUtilizada,
    uso: especie.data.etnobotanica.usoTradicional,
    compuestos,
    badgeColor: badge.color,
    badgeBg: badge.bg,
    img: especie.data.multimediaPrincipal.imagenUrl,
    slug: especie.data.slug ?? especie.id,
    categorias: matchedCategories.join(','),
    perfil: especie.data.perfilEtnobotanico,
  };
});

const plantasPerPage = 9;
const totalPages = Math.max(1, Math.ceil(plantas.length / plantasPerPage));
---

<div id="grid-especies" class="flex flex-wrap gap-5">
  {plantas.map((planta) => (
    <Etnobotanicacard
      {...planta}
    />
  ))}
</div>

<div class="mt-6">
  <Etnobotanicapagination currentPage={1} totalPages={totalPages} />
</div>
