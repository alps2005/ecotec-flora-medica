---
---

<div
  data-etnobotanica-modal
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="etnobotanica-modal-nombre"
>
  <div data-etnobotanica-modal-backdrop class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>

  <div class="relative z-10 max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-3xl bg-white shadow-2xl">
    <button
      type="button"
      data-etnobotanica-modal-close
      aria-label="Cerrar"
      class="absolute right-4 top-4 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-slate-600 shadow-sm transition hover:bg-white hover:text-slate-900"
    >
      <i class="ti ti-x" style="font-size:16px;"></i>
    </button>

    <div class="h-64 w-full overflow-hidden bg-slate-100 sm:h-80">
      <img data-modal-img src="" alt="" class="h-full w-full object-cover" />
    </div>

    <div class="p-6 sm:p-8">
      <p id="etnobotanica-modal-nombre" data-modal-nombre class="text-2xl font-semibold text-slate-900"></p>
      <p data-modal-cientifico class="mb-4 text-sm italic text-slate-400"></p>

      <span
        data-modal-categoria
        class="mb-6 inline-block rounded-md bg-primary/10 px-3 py-1 text-xs font-semibold text-primary"
      ></span>

      <div class="grid grid-cols-1 gap-4 border-t border-slate-100 pt-4 sm:grid-cols-2">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Parte usada</p>
          <p data-modal-parte class="mt-1 text-sm text-slate-700"></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Uso tradicional</p>
          <p data-modal-uso class="mt-1 text-sm text-slate-700"></p>
        </div>
      </div>

      <div class="mt-4 border-t border-slate-100 pt-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Compuestos</p>
        <p data-modal-compuestos class="mt-1 text-sm text-slate-700"></p>
      </div>

      <div class="mt-4 border-t border-slate-100 pt-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Perfil etnobotánico</p>
        <p data-modal-perfil class="mt-1 text-sm leading-6 text-slate-600"></p>
      </div>

      <a
        data-modal-link
        href="#"
        class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-primary px-4 py-3 text-xs font-bold uppercase tracking-[0.18em] text-white shadow-sm transition hover:bg-primary-fixed-dim"
      >
        Ver ficha completa
      </a>
    </div>
  </div>
</div>

<script>
  const initEtnobotanicaModal = () => {
    const modal = document.querySelector<HTMLElement>('[data-etnobotanica-modal]');
    if (!modal) return;

    const closeButton = modal.querySelector<HTMLButtonElement>('[data-etnobotanica-modal-close]');
    const backdrop = modal.querySelector<HTMLElement>('[data-etnobotanica-modal-backdrop]');
    const imgEl = modal.querySelector<HTMLImageElement>('[data-modal-img]');
    const nombreEl = modal.querySelector<HTMLElement>('[data-modal-nombre]');
    const cientificoEl = modal.querySelector<HTMLElement>('[data-modal-cientifico]');
    const categoriaEl = modal.querySelector<HTMLElement>('[data-modal-categoria]');
    const parteEl = modal.querySelector<HTMLElement>('[data-modal-parte]');
    const usoEl = modal.querySelector<HTMLElement>('[data-modal-uso]');
    const compuestosEl = modal.querySelector<HTMLElement>('[data-modal-compuestos]');
    const perfilEl = modal.querySelector<HTMLElement>('[data-modal-perfil]');
    const linkEl = modal.querySelector<HTMLAnchorElement>('[data-modal-link]');

    let lastFocused: HTMLElement | null = null;

    const openModal = (card: HTMLElement) => {
      const info = card.dataset;

      if (imgEl) {
        imgEl.src = info.infoImg ?? '';
        imgEl.alt = info.infoNombre ?? '';
      }
      if (nombreEl) nombreEl.textContent = info.infoNombre ?? '';
      if (cientificoEl) cientificoEl.textContent = info.infoCientifico ?? '';
      if (categoriaEl) categoriaEl.textContent = info.infoCategoria ?? '';
      if (parteEl) parteEl.textContent = info.infoParte || 'Sin información registrada.';
      if (usoEl) usoEl.textContent = info.infoUso || 'Sin información registrada.';
      if (compuestosEl) compuestosEl.textContent = info.infoCompuestos || 'Sin información registrada.';
      if (perfilEl) perfilEl.textContent = info.infoPerfil || 'Sin información registrada.';
      if (linkEl) linkEl.href = `/especies/${info.infoSlug ?? ''}`;

      lastFocused = document.activeElement as HTMLElement | null;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      closeButton?.focus();
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('overflow-hidden');
      lastFocused?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-etnobotanica-open-modal]').forEach((card) => {
      card.addEventListener('click', () => openModal(card));
    });

    closeButton?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  };

  initEtnobotanicaModal();
  document.addEventListener('astro:page-load', initEtnobotanicaModal);
</script>
