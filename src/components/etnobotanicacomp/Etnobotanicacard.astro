---
interface Props {
  nombre: string;
  cientifico: string;
  categoria: string;
  icono: string;
  parteUsada: string;
  uso: string;
  compuestos: string;
  badgeColor: string;
  badgeBg: string;
  img: string;
  slug: string;
  categorias: string;
  perfil: string;
}

const {
  nombre,
  cientifico,
  categoria,
  icono,
  parteUsada,
  uso,
  compuestos,
  badgeColor,
  badgeBg,
  img,
  slug,
  categorias,
  perfil,
} = Astro.props;
---

<button
  type="button"
  data-etnobotanica-open-modal
  data-categoria={categorias}
  data-info-nombre={nombre}
  data-info-cientifico={cientifico}
  data-info-categoria={categoria}
  data-info-parte={parteUsada}
  data-info-uso={uso}
  data-info-compuestos={compuestos}
  data-info-img={img}
  data-info-slug={slug}
  data-info-perfil={perfil}
  aria-haspopup="dialog"
  class="tarjeta-especie flex w-full flex-none flex-col appearance-none overflow-hidden rounded-2xl border border-slate-200 bg-white text-left transition duration-200 hover:-translate-y-0.5 hover:border-primary/20 hover:shadow-[0_24px_70px_-28px_rgba(0,73,164,0.22)] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 md:w-[calc((100%_-_1.25rem)/2)] xl:w-[calc((100%_-_2.5rem)/3)]"
>
  <div class="h-48 relative overflow-hidden bg-slate-100">
    <img
      src={img}
      alt={nombre}
      class="w-full h-full object-cover"
    />
    <span
      class={`absolute top-3 right-3 bg-white shadow-sm ${badgeColor} text-xs font-semibold px-3 py-1 rounded-md flex items-center gap-1`}
    >
      <i class={`ti ${icono}`} style="font-size:12px;"></i>
      {categoria}
    </span>
  </div>

  <div class="p-5">
    <p class="text-base font-semibold text-slate-900 mb-0.5">{nombre}</p>
    <p class="text-sm text-slate-400 italic mb-4">{cientifico}</p>

    <div class="border-t border-slate-100 pt-3 space-y-2">
      <div class="flex justify-between items-start">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Parte usada</p>
        <p class="text-sm text-slate-600 text-right">{parteUsada}</p>
      </div>
      <div class="flex justify-between items-start border-t border-slate-100 pt-2">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Uso</p>
        <p class="text-sm text-slate-600 text-right">{uso}</p>
      </div>
    </div>

    <p class="text-xs text-slate-400 mt-3 pt-3 border-t border-slate-100">{compuestos}</p>
  </div>
</button>
