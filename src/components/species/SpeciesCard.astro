---
interface Props {
  nombreComun: string;
  nombreCientifico: string;
  familia: string;
  descripcion: string;
  imagenUrl: string;
  accent: string;
  slug: string;
}

const { nombreComun, nombreCientifico, familia, descripcion, imagenUrl, accent, slug } = Astro.props;
---

<a
  href={`/especies/${slug}`}
  data-species-card
  data-family={familia}
  data-search-text={`${nombreComun} ${nombreCientifico} ${familia} ${descripcion}`.toLowerCase()}
  class="block w-full flex-none md:w-[calc((100%_-_1.5rem)/2)] xl:w-[calc((100%_-_3rem)/3)]"
>
  <article
    class="group h-full overflow-hidden rounded-[1.75rem] border border-slate-200/80 bg-white shadow-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_-28px_rgba(0,73,164,0.25)]"
  >
    <div class="aspect-4/3 overflow-hidden bg-slate-100">
      <img
        src={imagenUrl}
        alt={`Detalle de ${nombreComun}, ${nombreCientifico}`}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
    <div class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
            {familia}
          </p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-950">
            {nombreComun}
          </h2>
        </div>
        <span class={`rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] ${accent}`}>
          {familia}
        </span>
      </div>
      <p class="mt-3 text-sm italic text-slate-600">{nombreCientifico}</p>
      <p class="mt-4 text-sm leading-7 text-slate-700">
        {descripcion}
      </p>
    </div>
  </article>
</a>
