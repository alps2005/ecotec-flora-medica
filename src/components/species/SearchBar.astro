---
interface Props {
  placeholder: string;
}

const { placeholder } = Astro.props;
---

<label class="flex flex-1 flex-col gap-2 text-sm font-medium text-slate-700">
  <span>Buscar especies</span>
  <input
    data-species-search
    type="search"
    placeholder={placeholder}
    class="w-full rounded-full border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm outline-none transition focus:border-primary"
  />
</label>
