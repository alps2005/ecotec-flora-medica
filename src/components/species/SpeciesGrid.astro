---
import SpeciesCard from './SpeciesCard.astro';

interface Props {
  species: Array<{
    id: string;
    data: {
      slug?: string;
      nombreComun: string;
      nombreCientifico: string;
      taxonomia: {
        familia: string;
      };
      etnobotanica?: {
        usoTradicional?: string;
      };
      multimediaPrincipal?: {
        imagenUrl?: string;
      };
    };
  }>;
}

const { species } = Astro.props;

const familyAccentMap = new Map<string, string>([
  ['Rutaceae', 'bg-primary/10 text-primary border-primary/20'],
  ['Lamiaceae', 'bg-secondary/15 text-tertiary border-secondary/20'],
  ['Asteraceae', 'bg-tertiary/10 text-secondary border-tertiary/20'],
]);

const getAccent = (family: string) => {
  const index = Array.from(new Set(species.map((item) => item.data.taxonomia.familia))).indexOf(family);
  const palette = [
    'bg-primary/10 text-primary border-primary/20',
    'bg-secondary/15 text-tertiary border-secondary/20',
    'bg-tertiary/10 text-secondary border-tertiary/20',
  ];
  return familyAccentMap.get(family) ?? palette[index % palette.length] ?? palette[0];
};
---

<div data-species-root class="space-y-6">
  <div class="flex flex-wrap gap-6">
    {species.map((entry) => {
      const familia = entry.data.taxonomia.familia;
      const descripcion = entry.data.etnobotanica?.usoTradicional ?? '';
      const imagenUrl = entry.data.multimediaPrincipal?.imagenUrl ?? '';
      const slug = entry.data.slug ?? entry.id;

      return (
        <SpeciesCard
          nombreComun={entry.data.nombreComun}
          nombreCientifico={entry.data.nombreCientifico}
          familia={familia}
          descripcion={descripcion}
          imagenUrl={imagenUrl}
          accent={getAccent(familia)}
          slug={slug}
        />
      );
    })}
  </div>

  <div data-species-empty class="hidden rounded-[1.5rem] border border-dashed border-slate-300 bg-white/70 p-10 text-center text-slate-600">
    <p class="text-lg font-semibold text-slate-900">No se encontraron especies</p>
    <p class="mt-2 text-sm">Prueba con otra búsqueda o cambia el filtro por familia.</p>
  </div>
</div>
