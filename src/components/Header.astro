---
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="fixed top-0 left-0 w-full z-50">
  <nav class="flex items-center justify-between p-6 bg-blur backdrop-blur-xl bg-white/60 shadow-md px-90">
    <HeaderLink href="/" class="logo-font">
      {SITE_TITLE}
    </HeaderLink>
    <div class="flex justify-between gap-8 items-center">
        <HeaderLink href="/especies">Especies</HeaderLink>
        <HeaderLink href="/etnobotanica">Etnobotánica</HeaderLink>
        <HeaderLink href="/blog">Blog</HeaderLink>
    </div>
    <HeaderLink href="/suscribirse" class="border border-[#1B6D24] text-[#1B6D24] rounded-2xl px-6 py-1 hover:bg-[#1B6D24] hover:text-white">
      Suscribirse
    </HeaderLink>
  </nav>
</header>
