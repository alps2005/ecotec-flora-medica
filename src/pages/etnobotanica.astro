---
import Layout from '../layouts/Layout.astro';
import EtnobotanicaHero from '../components/etnobotanicacomp/Etnobotanicahero.astro';
import EtnobotanicaFilters from '../components/etnobotanicacomp/Etnobotanicafilters.astro';
import EtnobotanicaGrid from '../components/etnobotanicacomp/Etnobotanicagrid.astro';
---

<Layout
  title="Etnobotánica | Ecotec Flora Médica"
  description="Atlas Etnobotánico: explora la relación entre plantas medicinales y el cuerpo humano."
>
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-16 lg:px-0">

    <EtnobotanicaHero />

    <div class="rounded-3xl p-8" style="background-color: #F7FAF6; border: 1px solid #dde8db;">
      <EtnobotanicaFilters />
      <EtnobotanicaGrid />
    </div>

  </section>
</Layout>

<script>
  const initEtnobotanicaFilters = () => {
    const buttons = Array.from(
      document.querySelectorAll<HTMLElement>('[data-etnobotanica-filter]'),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.tarjeta-especie'),
    );

    if (!buttons.length) return;

    const ACTIVE   = ['bg-emerald-900', 'text-white', 'border-emerald-900'];
    const INACTIVE = ['bg-white', 'text-slate-600', 'border-slate-300'];

    const applyFilter = (cat: string) => {
      buttons.forEach((b) => {
        const isActive = b.dataset.cat === cat;
        b.classList.toggle('bg-emerald-900',   isActive);
        b.classList.toggle('text-white',        isActive);
        b.classList.toggle('border-emerald-900',isActive);
        b.classList.toggle('bg-white',         !isActive);
        b.classList.toggle('text-slate-600',   !isActive);
        b.classList.toggle('border-slate-300', !isActive);
      });

      cards.forEach((card) => {
        const show = cat === 'GENERAL' || card.dataset.categoria === cat;
        card.style.display = show ? 'block' : 'none';
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => applyFilter(btn.dataset.cat ?? 'GENERAL'));
    });
  };

  initEtnobotanicaFilters();
  document.addEventListener('astro:page-load', initEtnobotanicaFilters);
</script>