---
import Layout from '../layouts/Layout.astro';
import EtnobotanicaHero from '../components/etnobotanicacomp/Etnobotanicahero.astro';
import EtnobotanicaFilters from '../components/etnobotanicacomp/Etnobotanicafilters.astro';
import EtnobotanicaGrid from '../components/etnobotanicacomp/Etnobotanicagrid.astro';
---

<Layout
  title="Etnobotánica | Ecotec Flora Médica"
  description="Atlas Etnobotánico: explora la relación entre plantas medicinales y el cuerpo humano."
>
  <section class="mx-auto max-w-[1480px] px-6 pt-32 pb-16 lg:px-8">

    <EtnobotanicaHero />

    <div class="rounded-3xl border border-primary/10 bg-surface-muted p-8 shadow-sm">
      <EtnobotanicaFilters />
      <EtnobotanicaGrid />
    </div>

  </section>
</Layout>

<script>
  const ETNOBOTANICA_PER_PAGE = 9;

  const initEtnobotanicaFilters = () => {
    const buttons = Array.from(
      document.querySelectorAll<HTMLElement>('[data-etnobotanica-filter]'),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.tarjeta-especie'),
    );
    const pagination = document.querySelector<HTMLElement>('[data-etnobotanica-pagination]');
    const pageStatus = pagination?.querySelector<HTMLElement>('[data-etnobotanica-page-status]');
    const pageList = pagination?.querySelector<HTMLElement>('[data-etnobotanica-page-list]');
    const previousButton = pagination?.querySelector<HTMLButtonElement>('[data-etnobotanica-page-prev]');
    const nextButton = pagination?.querySelector<HTMLButtonElement>('[data-etnobotanica-page-next]');

    if (!buttons.length) return;

    let currentPage = 1;
    let currentCategory = 'GENERAL';

    const renderPageButtons = (totalPages: number) => {
      if (!pageList) return;

      pageList.innerHTML = '';

      Array.from({ length: totalPages }, (_, index) => index + 1).forEach((page) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.etnobotanicaPageButton = page.toString();
        button.textContent = page.toString();
        button.className =
          page === currentPage
            ? 'flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-medium text-white'
            : 'flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 text-sm font-medium text-slate-600 transition hover:bg-slate-50';
        button.setAttribute('aria-current', page === currentPage ? 'page' : 'false');
        button.addEventListener('click', () => {
          currentPage = page;
          applyFilter(currentCategory);
        });

        pageList.append(button);
      });
    };

    const applyFilter = (cat: string) => {
      currentCategory = cat;

      buttons.forEach((b) => {
        const isActive = b.dataset.cat === cat;
        b.classList.toggle('bg-primary',       isActive);
        b.classList.toggle('text-white',        isActive);
        b.classList.toggle('border-primary',    isActive);
        b.classList.toggle('bg-white',         !isActive);
        b.classList.toggle('text-slate-600',   !isActive);
        b.classList.toggle('border-slate-300', !isActive);
      });

      const matchingCards = cards.filter((card) => cat === 'GENERAL' || card.dataset.categoria === cat);
      const totalPages = Math.max(1, Math.ceil(matchingCards.length / ETNOBOTANICA_PER_PAGE));
      currentPage = Math.min(currentPage, totalPages);

      const pageStart = (currentPage - 1) * ETNOBOTANICA_PER_PAGE;
      const pageEnd = pageStart + ETNOBOTANICA_PER_PAGE;
      const visibleCards = new Set(matchingCards.slice(pageStart, pageEnd));

      cards.forEach((card) => {
        card.classList.toggle('hidden', !visibleCards.has(card));
      });

      if (pageStatus) {
        pageStatus.textContent =
          matchingCards.length > 0
            ? `Página ${currentPage} de ${totalPages}`
            : 'Sin resultados';
      }

      if (pagination) {
        pagination.classList.toggle('hidden', matchingCards.length === 0);
      }

      if (previousButton) previousButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= totalPages;
      renderPageButtons(totalPages);
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentPage = 1;
        applyFilter(btn.dataset.cat ?? 'GENERAL');
      });
    });
    previousButton?.addEventListener('click', () => {
      currentPage -= 1;
      applyFilter(currentCategory);
    });
    nextButton?.addEventListener('click', () => {
      currentPage += 1;
      applyFilter(currentCategory);
    });
    applyFilter(currentCategory);
  };

  initEtnobotanicaFilters();
  document.addEventListener('astro:page-load', initEtnobotanicaFilters);
</script>
