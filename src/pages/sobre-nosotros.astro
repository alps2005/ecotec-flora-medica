---
import Layout from "../layouts/Layout.astro";

const departamentos = [
  { icon: "ti-database", label: "Base de datos" },
  { icon: "ti-code", label: "Desarrollo" },
  { icon: "ti-palette", label: "Diseño" },
  { icon: "ti-server-2", label: "Infraestructura" },
  { icon: "ti-file-text", label: "Documentación" },
];

const values = [
  {
    tag: "#RigorCientífico",
    title: "Rigor científico",
    description:
      "Cada ficha se construye bajo un marco de validación empírica: taxonomía verificada, fuentes citadas y datos revisados.",
    theme: "white",
  },
  {
    tag: "#RespetoCultural",
    title: "Respeto cultural",
    description:
      "Documentamos el conocimiento etnobotánico honrando su origen y a las comunidades que lo han preservado por generaciones.",
    theme: "secondary",
  },
  {
    tag: "#Sostenibilidad",
    title: "Sostenibilidad",
    description:
      "Promovemos el aprovechamiento responsable de las especies y modelos que garantizan la regeneración de los ecosistemas.",
    theme: "white",
  },
  {
    tag: "#AccesoAbierto",
    title: "Acceso abierto",
    description:
      "Creemos que el saber botánico debe ser público, claro y accesible para estudiantes, investigadores y comunidad.",
    theme: "primary",
  },
];

const team = [
  {
    name: "Nestor Camilo Ruiz Conforme",
    role: "Docente de Vinculación",
    linkedin: "https://linkedin.com/in/nestor-camilo-ruiz-conforme-0b037b27",
    email: "mailto:nruizc@ecotec.edu.ec",
    photo: "",
  },
  {
    name: "Luis David Aurea Ramírez",
    role: "Líder de Base de Datos",
    linkedin: "https://www.linkedin.com/in/luis-david-aurea-ramirez-b42b13275",
    email: "mailto:luis.aurea2020@gmail.com",
    photo: "",
  },
  {
    name: "Luis Anibal Eraso Viteri",
    role: "Líder de Desarrollo",
    linkedin: "https://www.linkedin.com/in/luis-anibal-eraso-viteri-80b170301/",
    email: "mailto:erasoluis4565@gmail.com",
    photo: "",
  },
  {
    name: "Raúl Stephano Coello Albán",
    role: "Líder de Infraestructura",
    linkedin: "https://linkedin.com/in/raúl-stephano-coello-albán-023989243",
    email: "mailto:coellostephano@gmail.com",
    photo: "",
  },
  {
    name: "Adrian Leniel Palma Santana",
    role: "Líder de Diseño",
    linkedin: "linkedin.com/in/adrian-palma-a22009268",
    email: "mailto:adrianpalmasantana@gmail.com",
    photo: "",
  },
  {
    name: "-",
    role: "Líder de Documentación",
    linkedin: "",
    email: "",
    photo: "",
  },
];

const teamTints = ["bg-primary/10", "bg-secondary/15", "bg-primary/10", "bg-secondary/15"];
---

<Layout
  title="Sobre nosotros | Ecotec Flora Médica"
  description="Conoce el propósito, los valores y el equipo detrás del compendio de flora médica de la Universidad ECOTEC."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-primary/10">
    <div class="mx-auto max-w-7xl px-6 pt-32 pb-20 sm:px-8 lg:px-12">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
        Sobre nosotros
      </p>
      <div class="mt-6 space-y-3">
        <h1
          class="max-w-4xl text-5xl font-medium tracking-tight text-tertiary sm:text-6xl lg:text-7xl"
        >
          Ciencia y saber ancestral
        </h1>
        <h1
          class="max-w-4xl text-5xl font-medium italic tracking-tight text-primary sm:text-6xl lg:text-7xl"
        >
          al servicio de la salud.
        </h1>
      </div>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl">
        Somos un proyecto de vinculación de la Universidad ECOTEC dedicado a
        preservar, estudiar y difundir el conocimiento sobre la flora medicinal
        del Ecuador, uniendo el rigor de la investigación fitoquímica con el
        respeto por el saber tradicional.
      </p>
    </div>
  </section>

  <!-- Mission statement -->
  <section class="bg-surface-muted px-6 py-24 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-5xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
        Nuestra misión
      </p>
      <p
        class="mt-8 text-3xl font-light leading-tight text-slate-900 sm:text-4xl lg:text-5xl"
      >
        Construir un compendio riguroso y de acceso abierto que{" "}
        <span class="italic text-primary">proteja el patrimonio botánico</span> y
        acerque la investigación científica a quienes cuidan la salud y el
        territorio.
      </p>
    </div>
  </section>

  <!-- Departamentos band -->
  <section
    class="relative overflow-hidden border-y border-primary/10 bg-linear-to-r from-tertiary via-primary to-secondary"
  >
    <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 lg:px-12">
      <div class="mb-14 text-center">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">
          Un trabajo en equipo
        </h2>
        <p class="mt-3 text-base font-light text-white/80 sm:text-lg">
          Departamentos que colaboraron para hacer posible este proyecto.
        </p>
      </div>
      <div
        class="grid grid-cols-2 gap-12 text-center sm:grid-cols-3 lg:grid-cols-5 lg:gap-8"
      >
        {
          departamentos.map((depto) => (
            <div class="flex flex-col items-center gap-4 text-white">
              <i class={`ti ${depto.icon} text-6xl leading-none`} aria-hidden="true" />
              <p class="font-light">{depto.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface-muted px-6 py-24 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl space-y-16">
      <div class="max-w-4xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-primary"
        >
          Nuestro equipo
        </p>
        <h2
          class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"
        >
          Los líderes detrás del proyecto
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">
          Un equipo interdisciplinario de investigadores, docentes y estudiantes
          comprometidos con la ciencia abierta y la conservación.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-4">
        {
          team.map((member, index) => {
            const hasLinks = Boolean(member.linkedin || member.email);
            const linkedinHref = member.linkedin.startsWith("http")
              ? member.linkedin
              : `https://${member.linkedin}`;
            const emailHref = member.email.startsWith("mailto:")
              ? member.email
              : `mailto:${member.email}`;
            const initials = member.name
              .split(" ")
              .filter((part) => !part.endsWith("."))
              .slice(0, 2)
              .map((part) => part.charAt(0))
              .join("");

            return (
              <article class="group relative h-80 rounded-[1.75rem] shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-[0_24px_70px_-28px_rgba(0,73,164,0.25)] perspective-distant">
                <div
                  class:list={[
                    "relative h-full w-full transition-transform duration-500 transform-3d",
                    hasLinks &&
                      "group-hover:transform-[rotateY(180deg)] group-focus-within:transform-[rotateY(180deg)]",
                  ]}
                >
                  {/* Front */}
                  <div class="absolute inset-0 flex flex-col overflow-hidden rounded-[1.75rem] border border-slate-200/80 bg-white backface-hidden">
                    <div
                      class:list={[
                        "relative flex flex-1 items-center justify-center overflow-hidden",
                        teamTints[index % teamTints.length],
                      ]}
                    >
                      {member.photo ? (
                        <img
                          src={member.photo}
                          alt={`Foto de ${member.name}`}
                          loading="lazy"
                          class="h-full w-full object-cover"
                        />
                      ) : (
                        <span class="text-5xl font-semibold text-primary/40">
                          {initials}
                        </span>
                      )}
                    </div>
                    <div class="p-6">
                      <h3 class="text-lg font-semibold text-slate-900">
                        {member.name}
                      </h3>
                      <p class="mt-1 text-sm text-text-muted">{member.role}</p>
                    </div>
                  </div>

                  {/* Back */}
                  {hasLinks && (
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 overflow-hidden rounded-[1.75rem] bg-linear-to-br from-tertiary to-primary px-6 text-center text-white transform-[rotateY(180deg)] backface-hidden">
                      <p class="text-lg font-semibold">{member.name}</p>
                      <p class="text-sm font-light text-white/80">{member.role}</p>
                      <div class="mt-2 flex items-center gap-4">
                        {member.linkedin && (
                          <a
                            href={linkedinHref}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`LinkedIn de ${member.name}`}
                            class="rounded-full bg-white/15 p-3 transition hover:bg-white/25"
                          >
                            <i class="ti ti-brand-linkedin text-2xl" aria-hidden="true" />
                          </a>
                        )}
                        {member.email && (
                          <a
                            href={emailHref}
                            aria-label={`Correo de ${member.name}`}
                            class="rounded-full bg-white/15 p-3 transition hover:bg-white/25"
                          >
                            <i class="ti ti-mail text-2xl" aria-hidden="true" />
                          </a>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="px-6 py-24 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-7xl space-y-16">
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-primary"
        >
          Nuestros valores
        </p>
        <h2
          class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"
        >
          Los principios que guían nuestro trabajo
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-2">
        {
          values.map((value) => (
            <article
              class:list={[
                "flex flex-col rounded-[28px] px-8 py-10 shadow-sm ring-1",
                value.theme === "secondary" &&
                  "bg-secondary/15 ring-secondary/20",
                value.theme === "primary" && "bg-primary/10 ring-primary/10",
                value.theme === "white" && "bg-white ring-primary/10",
              ]}
            >
              <h3 class="text-2xl font-semibold text-slate-900">
                {value.title}
              </h3>
              <p class="mt-4 text-base leading-8 text-slate-600">
                {value.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="px-6 py-24 sm:px-8 lg:px-12">
    <div
      class="mx-auto flex max-w-5xl flex-col items-center gap-8 rounded-[32px] border border-primary/10 bg-white/70 px-8 py-16 text-center shadow-[0_20px_60px_-24px_rgba(0,73,164,0.2)] backdrop-blur-sm"
    >
      <h2
        class="max-w-2xl text-4xl font-light italic leading-tight text-slate-900 sm:text-5xl"
      >
        Explora el compendio de flora médica
      </h2>
      <p class="max-w-2xl text-lg leading-8 text-slate-700">
        Descubre las especies, su contexto etnobotánico y los compuestos que las
        hacen valiosas para la salud y la ciencia.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-primary-fixed-dim"
          href="/especies"
        >
          Explorar especies
        </a>
        <a
          class="inline-flex items-center justify-center rounded-full border border-primary/15 bg-white/80 px-6 py-3 text-sm font-semibold text-tertiary transition hover:border-primary/25 hover:bg-white"
          href="/etnobotanica"
        >
          Ver etnobotánica
        </a>
      </div>
    </div>
  </section>
</Layout>
