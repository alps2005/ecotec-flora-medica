  <script src="../scripts/suscripcion.js"></script>
  <script>
    import gsap from "gsap";

    const CHANGE_INTERVAL = 5000;
    const FADE_DURATION = 0.45;
    const STAGGER_DELAY = 200;

    const shuffleArray = (array) => {
      const arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    };

    const preloadImage = (src) => {
      return new Promise((resolve) => {
        const img = new Image();
        img.src = src;
        img.onload = resolve;
        img.onerror = resolve;
      });
    };

    const preloadImages = (images) => {
      return Promise.all(images.map((img) => preloadImage(img.src)));
    };

    const getNextImages = (currentSrcs, allImages, count) => {
      let pool = allImages.filter((img) => !currentSrcs.includes(img.src));

      if (pool.length < count) {
        pool = allImages;
      }

      const shuffled = shuffleArray(pool);
      return shuffled.slice(0, count);
    };

    const updateSlot = (slot, nextImage) => {
      const img = slot.querySelector("[data-species-image]");
      const label = slot.querySelector("[data-species-label]");

      if (
        !(img instanceof HTMLImageElement) ||
        !(label instanceof HTMLElement)
      ) {
        return;
      }

      gsap.to(slot, {
        opacity: 0,
        duration: FADE_DURATION,
        ease: "power2.inOut",
        onComplete: () => {
          img.src = nextImage.src;
          img.alt = `Imagen de ${nextImage.name}`;
          label.textContent = nextImage.name;

          gsap.to(slot, {
            opacity: 1,
            duration: FADE_DURATION,
            ease: "power2.inOut",
          });
        },
      });
    };

    const initSpeciesGrid = () => {
      const gridEl = document.getElementById("species-grid");
      if (!gridEl) {
        return;
      }

      if (gridEl.dataset.speciesGridBound === "true") {
        return;
      }
      gridEl.dataset.speciesGridBound = "true";

      const speciesImages = JSON.parse(gridEl.dataset.speciesImages || "[]");
      const slots = Array.from(gridEl.querySelectorAll("[data-species-slot]"));

      if (!slots.length || !speciesImages.length) {
        return;
      }

      const runCycle = async () => {
        const currentSrcs = slots
          .map((slot) => {
            const img = slot.querySelector("[data-species-image]");
            return img ? img.getAttribute("src") : null;
          })
          .filter(Boolean);

        const nextImages = getNextImages(currentSrcs, speciesImages, slots.length);

        if (nextImages.length < slots.length) {
          return;
        }

        const timeoutPromise = new Promise((resolve) =>
          setTimeout(resolve, 1500),
        );
        await Promise.race([preloadImages(nextImages), timeoutPromise]);

        const shuffledSlots = shuffleArray(
          slots.map((slot, index) => ({ slot, index })),
        );

        shuffledSlots.forEach(({ slot }, staggerIndex) => {
          const nextImage = nextImages[staggerIndex];
          if (nextImage) {
            setTimeout(() => {
              updateSlot(slot, nextImage);
            }, staggerIndex * STAGGER_DELAY);
          }
        });
      };

      if (window.speciesGridInterval) {
        clearInterval(window.speciesGridInterval);
      }
      window.speciesGridInterval = setInterval(runCycle, CHANGE_INTERVAL);
    };

    initSpeciesGrid();
    document.addEventListener("astro:page-load", initSpeciesGrid);
  </script>
</Layout>
