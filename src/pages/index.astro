---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
const species = (await getCollection(
  "species",
)) as CollectionEntry<"species">[];
posts.sort(
  (left: CollectionEntry<"blog">, right: CollectionEntry<"blog">) =>
    right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const speciesImages = species
  .map((entry) => ({
    src: entry.data.multimediaPrincipal.imagenUrl,
    name: entry.data.nombreComun,
  }))
  .filter((image) => Boolean(image.src));
const initialSpeciesImages = [...speciesImages]
  .sort(() => Math.random() - 0.5)
  .slice(0, 5);
const pageSectionSpacing = "px-4 py-24 sm:px-6 lg:px-30";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="relative overflow-hidden border-b border-primary/10">
    <div
      class="flex min-h-screen max-w-full justify-evenly items-center pt-24 pb-20 mx-30"
    >
      <div class="space-y-8">
        <span
          class="inline-flex items-center border-b text-xs font-medium text-tertiary"
        >
          HERBARIUM DIGITAL
        </span>
        <div class="space-y-5">
          <h1
            class="max-w-3xl text-5xl font-medium tracking-tight text-tertiary sm:text-6xl lg:text-7xl"
          >
            El saber ancestral
          </h1>
          <h1
            class="max-w-3xl text-5xl font-medium italic tracking-tight text-primary sm:text-6xl lg:text-7xl"
          >
            en la lente científica.
          </h1>
          <div class="flex flex-col gap-4">
            <p class="max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl">
              {SITE_DESCRIPTION}
            </p>
            <p class="max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl">
              Encuentra especies, contexto etnobotánico y lecturas claras para
              entender la relación entre plantas, salud y territorio.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-primary-fixed-dim"
            href="/especies"
          >
            Explorar especies
          </a>
          <a
            class="inline-flex items-center justify-center rounded-full border border-primary/15 bg-white/80 px-6 py-3 text-sm font-semibold text-tertiary transition hover:border-primary/25 hover:bg-white"
            href="/blog"
          >
            Leer blogs
          </a>
        </div>
      </div>

      <div class="grid h-150 grid-cols-2 grid-rows-[repeat(3,minmax(0,1fr))] gap-4">
        <div
          class="species-grid-tile group relative overflow-hidden rounded-xl shadow-sm"
          data-species-slot
        >
          <img
            src={initialSpeciesImages[0]?.src}
            alt={initialSpeciesImages[0]?.name ?? "Imagen de especies"}
            class="species-grid-image h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            data-species-image
