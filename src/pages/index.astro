---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import homeGridImage1 from "../assets/home_images/home_image_grid_test.webp";

const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
posts.sort(
  (left: CollectionEntry<"blog">, right: CollectionEntry<"blog">) =>
    right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="relative overflow-hidden border-b border-emerald-950/10">
    <div class="flex min-h-screen max-w-full justify-evenly items-center gap-14 pt-24 pb-20 mx-30">
      <div class="space-y-8">
        <span class="inline-flex items-center text-xs font-medium text-[#2E7D32] border-b" >
          HERBARIUM DIGITAL
        </span>
        <div class="space-y-5">
          <h1 class="max-w-3xl text-5xl font-medium tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
            El saber ancestral
          </h1>
          <h1 class="max-w-3xl text-5xl font-medium italic tracking-tight text-[#2E7D32] sm:text-6xl lg:text-7xl">
            en la lente científica.
          </h1>
          <div class="flex flex-col gap-4">
            <p class="max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl">
              {SITE_DESCRIPTION}
            </p>
            <p class="max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl">
              Encuentra especies, contexto etnobotánico y lecturas claras para
              entender la relación entre plantas, salud y territorio.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            class="inline-flex items-center justify-center rounded-full bg-[#0D631B] px-6 py-3 text-sm font-semibold text-white transition hover:bg-green-700"
            href="/especies"
          >
            Explorar especies
          </a>
          <a
            class="inline-flex items-center justify-center rounded-full border border-emerald-900/15 bg-white/80 px-6 py-3 text-sm font-semibold text-emerald-950 transition hover:border-emerald-900/25 hover:bg-white"
            href="/blog"
          >
            Leer blogs
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 grid-rows-3 gap-4 h-150">
        <div class="rounded-xl overflow-hidden shadow-sm relative group">
          <img
            src={homeGridImage1.src}
            alt="Imagen de plantas medicinales"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm relative group">
          <img
            src={homeGridImage1.src}
            alt="Imagen de plantas medicinales"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm relative group row-span-2">
          <img
          src={homeGridImage1.src}
          alt="Imagen de plantas medicinales"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm relative group">
          <img
            src={homeGridImage1.src}
            alt="Imagen de plantas medicinales"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm relative group">
          <img
            src={homeGridImage1.src}
            alt="Imagen de plantas medicinales"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      </div>
      
