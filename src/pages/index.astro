---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
const species = (await getCollection(
  "species",
  ({ data }) => data.estado === "ACTIVO",
)) as CollectionEntry<"species">[];
posts.sort(
  (left: CollectionEntry<"blog">, right: CollectionEntry<"blog">) =>
    right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const uniqueFamilies = new Set(
  species.map((entry) => entry.data.taxonomia.familia),
);
const totalCompounds = species.reduce(
  (sum, entry) => sum + entry.data.compuestosQuimicos.length,
  0,
);
const speciesImages = species
  .map((entry) => ({
    src: entry.data.multimediaPrincipal.imagenUrl,
    name: entry.data.nombreComun,
  }))
  .filter((image) => Boolean(image.src));
const shuffleSpeciesImages = (items: typeof speciesImages) => {
  const arr = [...items];
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
};
const initialSpeciesImages = shuffleSpeciesImages(speciesImages).slice(0, 5);
const pageSectionSpacing = "px-4 py-24 sm:px-6 lg:px-30";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
