  <script src="../scripts/suscripcion.js"></script>
  <script define:vars={{ speciesImages }}>
    import gsap from "gsap";

    const CHANGE_INTERVAL = 5000;
    const FADE_DURATION = 0.45;
    const slots = Array.from(document.querySelectorAll("[data-species-slot]"));

    const pickRandomImage = (currentSrc) => {
      if (!speciesImages.length) {
        return null;
      }

      const available = speciesImages.filter(
        (image) => image.src !== currentSrc,
      );
      const pool = available.length > 0 ? available : speciesImages;
      const index = Math.floor(Math.random() * pool.length);

      return pool[index] ?? null;
    };

    const updateSlot = (slot) => {
      const img = slot.querySelector("[data-species-image]");
      const label = slot.querySelector("[data-species-label]");

      if (
        !(img instanceof HTMLImageElement) ||
        !(label instanceof HTMLElement)
      ) {
        return;
      }

      const nextImage = pickRandomImage(img.src);

      if (!nextImage) {
        return;
      }

      gsap.to(slot, {
        opacity: 0,
        duration: FADE_DURATION,
        ease: "power2.inOut",
        onComplete: () => {
          img.src = nextImage.src;
          img.alt = `Imagen de ${nextImage.name}`;
          label.textContent = nextImage.name;

          gsap.to(slot, {
            opacity: 1,
            duration: FADE_DURATION,
            ease: "power2.inOut",
          });
        },
      });
    };

    const startSlotCycle = (slot, initialDelay) => {
      const tick = () => {
        updateSlot(slot);
        window.setTimeout(tick, CHANGE_INTERVAL);
      };

      window.setTimeout(tick, initialDelay);
    };

    const initSpeciesGrid = () => {
      if (
        !slots.length ||
        document.documentElement.dataset.speciesGridBound === "true"
      ) {
        return;
      }

      document.documentElement.dataset.speciesGridBound = "true";

      slots.forEach((slot) => {
        const delay = Math.floor(Math.random() * CHANGE_INTERVAL);
        startSlotCycle(slot, delay);
      });
    };

    initSpeciesGrid();
    document.addEventListener("astro:page-load", initSpeciesGrid);
  </script>
</Layout>
