---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
posts.sort(
  (left: CollectionEntry<"blog">, right: CollectionEntry<"blog">) =>
    right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section
    class="relative overflow-hidden border-b border-emerald-950/10"
  >
    <div
      class="mx-auto grid min-h-[82vh] max-w-6xl items-center gap-14 px-6 pt-34 pb-20 lg:grid-cols-[1.1fr_0.9fr] lg:px-0"
    >
      <div class="space-y-8">
        <span
          class="inline-flex items-center rounded-full border border-emerald-900/10 bg-white/80 px-4 py-1 text-sm font-medium text-emerald-900 shadow-sm backdrop-blur"
        >
          Flora médica de Ecotec
        </span>
        <div class="space-y-5">
          <h1
            class="max-w-3xl text-5xl font-semibold tracking-tight text-slate-950 sm:text-6xl lg:text-7xl"
          >
            {SITE_TITLE}
          </h1>
          <p class="max-w-2xl text-lg leading-8 text-slate-700 sm:text-xl">
            {SITE_DESCRIPTION} Encuentra especies, contexto etnobotánico y lecturas
            claras para entender la relación entre plantas, salud y territorio.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            class="inline-flex items-center justify-center rounded-full bg-emerald-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-emerald-600"
            href="/blog"
          >
            Leer el blog
          </a>
          <a
            class="inline-flex items-center justify-center rounded-full border border-emerald-900/15 bg-white/80 px-6 py-3 text-sm font-semibold text-emerald-950 transition hover:border-emerald-900/25 hover:bg-white"
            href="/especies"
          >
            Explorar especies
          </a>
        </div>
        <dl class="grid gap-4 pt-4 sm:grid-cols-3">
          <div
            class="rounded-2xl border border-emerald-900/10 bg-white/75 p-4 shadow-sm backdrop-blur"
          >
            <dt class="text-sm text-slate-500">Contenido claro</dt>
            <dd class="mt-1 text-lg font-semibold text-slate-950">
              Lectura rápida
            </dd>
          </div>
          <div
            class="rounded-2xl border border-emerald-900/10 bg-white/75 p-4 shadow-sm backdrop-blur"
          >
            <dt class="text-sm text-slate-500">Enfoque útil</dt>
            <dd class="mt-1 text-lg font-semibold text-slate-950">
              Especies y blog
            </dd>
          </div>
          <div
            class="rounded-2xl border border-emerald-900/10 bg-white/75 p-4 shadow-sm backdrop-blur"
          >
            <dt class="text-sm text-slate-500">SEO listo</dt>
            <dd class="mt-1 text-lg font-semibold text-slate-950">
              Meta y sitemap
            </dd>
          </div>
        </dl>
      </div>

      <div
        class="rounded-4xl border border-emerald-900/10 bg-slate-950 p-6 text-white shadow-2xl shadow-emerald-950/10 lg:p-8"
      >
        <div
          class="flex items-center justify-between border-b border-white/10 pb-4"
        >
          <p
            class="text-sm font-medium uppercase tracking-[0.25em] text-emerald-300"
          >
            Lectura destacada
          </p>
          <span
            class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80"
            >Blog</span
          >
        </div>
        {
          featuredPost ? (
            <article class="space-y-5 pt-6">
              <p class="text-sm text-white/60">
                {featuredPost.data.pubDate.toLocaleDateString("es-EC", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <h2 class="text-3xl font-semibold tracking-tight text-white">
                {featuredPost.data.title}
              </h2>
              <p class="text-base leading-7 text-white/75">
                {featuredPost.data.description}
              </p>
              <a
                class="inline-flex items-center text-sm font-semibold text-emerald-300 transition hover:text-emerald-200"
                href={`/blog/${featuredPost.id}`}
              >
                Leer artículo
              </a>
            </article>
          ) : (
            <p class="pt-6 text-white/75">
              Pronto publicaremos artículos sobre especies, usos y contexto
              etnobotánico.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="space-y-4">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700"
        >
          Por qué este sitio
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl"
        >
          Una landing que guía y un blog que profundiza.
        </h2>
        <p class="max-w-prose text-base leading-7 text-slate-700">
          La página principal presenta el proyecto con un mensaje claro,
          llamadas a la acción visibles y contenido de apoyo. El blog sirve para
          ampliar cada tema con artículos indexables y enlazables.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-950">
            Contenido orientado a búsqueda
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Títulos claros, descripciones útiles y enlaces internos con
            propósito.
          </p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-950">
            Arquitectura escalable
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            BaseHead centraliza SEO, Layout unifica estructura y el blog crece
            por colección.
          </p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-950">
            Acciones visibles
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            La navegación prioriza explorar especies, leer el blog y seguir
            rutas claras.
          </p>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-950">
            Preparado para crecer
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Puedes añadir más artículos y secciones sin cambiar la base del
            sitio.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
