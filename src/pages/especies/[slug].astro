---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getSpeciesList, getSpeciesDetail, IMAGE_PLACEHOLDER, type SpeciesData } from '../../lib/species-source';

export async function getStaticPaths() {
  // Mapa de contenido .md (respaldo garantizado y fuente del cuerpo Markdown).
  const mdEntries = await getCollection('species', ({ data }) => data.estado === 'ACTIVO');
  const mdBySlug = new Map(mdEntries.map((entry) => [entry.data.slug ?? entry.id, entry]));

  // Set de slugs = unión API ∪ md (getSpeciesList ya hace ese merge).
  const { rows } = await getSpeciesList();

  const paths = await Promise.all(
    rows.map(async (row) => {
      const slug = row.data.slug ?? row.id;
      const mdEntry = mdBySlug.get(slug) ?? null;
      // Detalle completo desde la API con merge por campo sobre el .md; si la API
      // falla, cae al .md (o a los datos livianos de la lista si es especie solo-API).
      const data = await getSpeciesDetail(slug, (mdEntry?.data as SpeciesData) ?? row.data);
      return { params: { slug }, props: { data, entry: mdEntry } };
    }),
  );

  return paths;
}

interface Props {
  data: SpeciesData;
  entry: CollectionEntry<'species'> | null;
}

const { data, entry } = Astro.props as Props;
const { etnobotanica, historiaEvolucion, comercio, compuestosQuimicos } = data;

// Cuerpo "Introducción y Contexto": preferir el análisis académico de la API;
// si no hay, renderizar el cuerpo Markdown del .md con <Content/>.
const analisis = data.analisisAcademico;
const analisisSecciones = [
  analisis?.taxonomia,
  analisis?.etnobotanica,
  analisis?.fitoquimica,
  analisis?.sostenibilidad,
].filter((section): section is string => Boolean(section && section.trim()));
const hasAnalisis = analisisSecciones.length > 0;
const Content = !hasAnalisis && entry ? (await render(entry)).Content : null;

const heroImage = data.multimediaPrincipal.imagenUrl || IMAGE_PLACEHOLDER;
const hasInternationalTrade = comercio.exportacion.length > 0 || comercio.importacion.length > 0;
const taxonomicRanks = [
  { label: 'Reino', value: data.taxonomia.reino },
  { label: 'División', value: data.taxonomia.division },
  { label: 'Clase', value: data.taxonomia.clase },
  { label: 'Familia', value: data.taxonomia.familia },
  { label: 'Género', value: data.taxonomia.genero },
];
const etnobotanyItems = [
  { label: 'Clasificación', value: etnobotanica.clasificacion },
  { label: 'Parte utilizada', value: etnobotanica.parteUtilizada },
  { label: 'Uso tradicional', value: etnobotanica.usoTradicional },
];
const historyItems = [
  { label: 'Origen', value: historiaEvolucion.origen },
  { label: 'Dispersión', value: historiaEvolucion.dispersion },
  { label: 'Evolución', value: historiaEvolucion.evolucion },
];

// Map family to accent color (same as in SpeciesGrid)
const familyAccentMap = new Map<string, string>([
  ['Rutaceae', 'bg-primary/15 text-primary border-primary/20'],
  ['Lamiaceae', 'bg-secondary/15 text-secondary border-secondary/20'],
  ['Asteraceae', 'bg-tertiary/15 text-tertiary border-tertiary/20'],
]);

const getAccent = (family: string) => {
  return familyAccentMap.get(family) ?? 'bg-primary/15 text-primary border-primary/20';
};

---

<Layout
  title={`${data.nombreComun} | Ecotec Flora Médica`}
  description={`Detalle completo de ${data.nombreComun} (${data.nombreCientifico}) - clasificación ${etnobotanica.clasificacion}`}
>
  <div class="mx-auto flex min-h-screen max-w-7xl px-6 pb-20 pt-32 lg:px-8">
    <main class="w-full flex-1">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/especies"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition hover:underline"
        >
          <span aria-hidden="true">←</span>
          <span>Volver al catálogo</span>
        </a>
        <span class={`rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] ${getAccent(data.taxonomia.familia)}`}>
          Familia: {data.taxonomia.familia}
        </span>
      </div>

      {/* Hero Section */}
      <section class="group relative mb-16 h-130 w-full overflow-hidden rounded-[2rem] bg-slate-100 shadow-[0_28px_80px_-34px_rgba(0,73,164,0.32)]">
        <img
          src={heroImage}
          alt={`${data.nombreComun} (${data.nombreCientifico})`}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-linear-to-t from-tertiary/90 via-tertiary/35 to-transparent"></div>
        <div class="absolute inset-x-6 bottom-8 flex flex-col gap-4 sm:inset-x-10 sm:bottom-10 lg:left-12 lg:right-12">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-white/90 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-primary shadow-sm">
              Familia: {data.taxonomia.familia}
            </span>
            {data.nombresAlternativos.length > 0 && (
              <span class="rounded-full border border-white/30 bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.22em] text-white backdrop-blur">
                {data.nombresAlternativos.join(' / ')}
              </span>
            )}
          </div>
          <div>
            <h1 class="max-w-3xl text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl">
              {data.nombreComun}
            </h1>
            <p class="mt-4 text-2xl italic text-secondary/85 sm:text-3xl">
              {data.nombreCientifico}
            </p>
          </div>
        </div>
      </section>

      {/* Taxonomic Breadcrumb */}
      <section id="taxonomia" class="mb-20">
        <div class="rounded-card border border-slate-200/80 bg-surface-muted/90 p-6 shadow-sm backdrop-blur-sm">
          <div class="flex flex-col gap-6 xl:flex-row xl:items-center xl:justify-between">
            <div class="flex flex-wrap items-stretch gap-y-6">
              {taxonomicRanks.map((rank, index) => (
                <div class={`pr-8 ${index < taxonomicRanks.length - 1 ? 'mr-8 border-r border-primary/15' : ''}`}>
                  <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.22em] text-primary/70">
                    {rank.label}
                  </span>
                  <span class="font-display text-xl font-semibold text-text">
                    {rank.value}
                  </span>
                </div>
              ))}
            </div>
            <span class="self-start text-[11px] font-bold uppercase tracking-[0.22em] text-primary xl:self-center">
              Clasificación taxonómica
            </span>
          </div>
        </div>
      </section>

      {/* Information Grid */}
      <div class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-12">
        {/* Academic Analysis */}
        <section class="flex flex-col gap-6 md:col-span-8">
          <div>
            <span class="mb-2 block text-xs font-bold uppercase tracking-[0.22em] text-primary">
              01 / Análisis académico
            </span>
            <h2 class="text-4xl font-semibold tracking-tight text-text sm:text-5xl">
              Introducción y Contexto
            </h2>
          </div>
          <div class="prose prose-slate max-w-none prose-headings:font-display prose-headings:text-text prose-p:text-slate-700 prose-p:leading-8 prose-strong:text-text">
            {hasAnalisis ? (
              analisisSecciones.map((section) => <p>{section}</p>)
            ) : Content ? (
              <Content />
            ) : (
              <p>Sin información registrada.</p>
            )}
          </div>
          <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {historyItems.map((item) => (
              <div class="border-l-4 border-primary py-2 pl-6">
                <span class="mb-1 block text-[10px] font-bold uppercase tracking-[0.22em] text-slate-500">
                  {item.label}
                </span>
                <p class="font-display text-xl font-semibold leading-7 text-text">
                  {item.value || 'Sin información registrada.'}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* Etnobotany Sidebar */}
        <aside class="md:col-span-4">
          <div class="relative h-full overflow-hidden rounded-card border border-tertiary/15 bg-tertiary/15 p-8 shadow-sm">
            <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-tertiary/15"></div>
            <div class="relative z-10">
              <span class="mb-6 block text-xs font-bold uppercase tracking-[0.22em] text-primary">
                Etnobotánica
              </span>
              <ul class="flex flex-col gap-8">
                {etnobotanyItems.map((item) => (
                  <li class="flex flex-col">
                    <span class="mb-1 text-[9px] font-bold uppercase tracking-[0.2em] text-primary">
                      {item.label}
                    </span>
                    <span class="text-lg font-semibold leading-7 text-text">
                      {item.value}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>

      {/* Chemical Compounds */}
      <section class="mb-20">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="mb-2 block text-xs font-bold uppercase tracking-[0.22em] text-primary">
              02 / Características químicas
            </span>
            <h2 class="text-4xl font-semibold tracking-tight text-text sm:text-5xl">
              Compuestos Químicos Activos
            </h2>
          </div>
          <span class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-500">
            <span>Perfil fitoquímico</span>
          </span>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {compuestosQuimicos.length > 0 ? compuestosQuimicos.map((compound) => (
            <article class="rounded-card border border-slate-200/80 bg-white/85 p-6 shadow-sm">
              <h3 class="mb-2 text-sm font-bold uppercase tracking-[0.16em] text-primary">
                {compound.nombre}
              </h3>
              <p class="text-sm leading-7 text-slate-600">
                {compound.detalle}
              </p>
            </article>
          )) : (
            <p class="rounded-card border border-slate-200/80 bg-white/85 p-6 text-sm leading-7 text-slate-600 shadow-sm md:col-span-3">
              Sin información registrada.
            </p>
          )}
        </div>
      </section>

      {/* Secondary Information Grid */}
      <section class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="rounded-card border border-slate-200/80 bg-white/85 p-8 shadow-sm md:col-span-7">
          <span class="mb-8 block text-xs font-bold uppercase tracking-[0.22em] text-primary">
            Comercio internacional
          </span>
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
            <div>
              <div class="mb-4 flex items-center gap-2">
                <h3 class="font-display text-xl font-semibold text-text">
                  Principales Exportadores
                </h3>
              </div>
              <div class="space-y-4">
                {hasInternationalTrade && comercio.exportacion.length > 0 ? comercio.exportacion.map((item) => (
                  <div class="border-b border-slate-200/80 pb-3">
                    <div class="flex items-start justify-between gap-4">
                      <span class="font-semibold text-text">{item.pais}</span>
                      <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary">Exportación</span>
                    </div>
                    <p class="mt-2 text-sm leading-7 text-slate-600">{item.detalle}</p>
                  </div>
                )) : (
                  <p class="text-sm leading-7 text-slate-600">Sin información registrada.</p>
                )}
              </div>
            </div>
            <div>
              <div class="mb-4 flex items-center gap-2">
                <h3 class="font-display text-xl font-semibold text-text">
                  Principales Importadores
                </h3>
              </div>
              <div class="space-y-4">
                {hasInternationalTrade && comercio.importacion.length > 0 ? comercio.importacion.map((item) => (
                  <div class="border-b border-slate-200/80 pb-3">
                    <div class="flex items-start justify-between gap-4">
                      <span class="font-semibold text-text">{item.pais}</span>
                      <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary">Importación</span>
                    </div>
                    <p class="mt-2 text-sm leading-7 text-slate-600">{item.detalle}</p>
                  </div>
                )) : (
                  <p class="text-sm leading-7 text-slate-600">Sin información registrada.</p>
                )}
              </div>
            </div>
          </div>
        </div>

        <aside class="relative overflow-hidden rounded-card border border-tertiary/15 bg-tertiary/15 p-8 shadow-sm md:col-span-5">
          <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-tertiary/15"></div>
          <div class="relative z-10">
            <div class="mb-6 flex items-start justify-between gap-4">
              <span class="text-xs font-bold uppercase tracking-[0.22em] text-tertiary">
                Perfil etnobotánico
              </span>
            </div>
            <h3 class="mb-4 font-display text-2xl font-semibold text-text">
              Uso Tradicional y Medicina
            </h3>
            <div class="space-y-6">
              <div class="rounded-xl border border-white/60 bg-white/55 p-4">
                <span class="mb-1 block text-[9px] font-bold uppercase tracking-[0.2em] text-tertiary">
                  Indicación principal
                </span>
                <p class="text-sm leading-7 text-slate-700">
                  {etnobotanica.usoTradicional || 'Sin información registrada.'}
                </p>
              </div>
              <div class="rounded-xl border border-white/60 bg-white/55 p-4">
                <span class="mb-1 block text-[9px] font-bold uppercase tracking-[0.2em] text-tertiary">
                  Perfil registrado
                </span>
                <p class="text-sm leading-7 text-slate-700">
                  {data.perfilEtnobotanico || 'Sin información registrada.'}
                </p>
              </div>
              <a
                href="#taxonomia"
                class="inline-flex w-full justify-center rounded-xl bg-primary px-4 py-3 text-xs font-bold uppercase tracking-[0.18em] text-white shadow-sm transition hover:bg-primary-fixed-dim"
              >
                Ver clasificación completa
              </a>
            </div>
          </div>
        </aside>
      </section>
    </main>
  </div>
</Layout>
