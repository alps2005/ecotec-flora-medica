---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/species/SearchBar.astro';
import SpeciesGrid from '../components/species/SpeciesGrid.astro';
import TaxonomyFilter from '../components/species/TaxonomyFilter.astro';
import Pagination from '../components/species/Pagination.astro';

const species = (await getCollection('species')).sort((a, b) =>
  a.data.nombreComun.localeCompare(b.data.nombreComun),
);
const families = [...new Set(species.map((entry) => entry.data.taxonomia.familia))];
const speciesPerPage = 9;
const totalPages = Math.max(1, Math.ceil(species.length / speciesPerPage));
---

<Layout
  title="Especies | Ecotec Flora Médica"
  description="Catálogo editorial de especies medicinales con búsquedas y filtros taxonómicos."
>
  <section class="mx-auto max-w-370 px-6 pb-16 pt-32 lg:px-8">
    <div class="grid gap-8 lg:grid-rows">
      <div class="">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
          Especies
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
          Catálogo de especies
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">
          Una mirada editorial y minimalista a las especies medicinales que
          acompañan la narrativa del proyecto, preparada para sustituir su
          contenido por una API real sin reestructurar la experiencia.
        </p>
      </div>

      <div class="rounded-4xl border border-slate-200/80 bg-white/80 p-8 shadow-[0_20px_60px_-24px_rgba(27,109,36,0.2)] backdrop-blur-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">
          Exposición
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          {families.map((family) => (
            <span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
              {family}
            </span>
          ))}
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          El catálogo combina búsqueda libre y filtros por familia taxonómica
          para ofrecer una navegación más cercana a un museo botánico.
        </p>
      </div>
    </div>

    <div class="mt-12 rounded-4xl border border-slate-200/80 bg-[#F7FAF6]/80 p-6 shadow-sm backdrop-blur-sm">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <SearchBar placeholder="Buscar por nombre, familia o descripción" />
        <TaxonomyFilter families={families} />
      </div>

      <div class="mt-6">
        <SpeciesGrid species={species} />
      </div>

      <div class="mt-6">
        <Pagination currentPage={1} totalPages={totalPages} />
      </div>
    </div>
  </section>
</Layout>

<script>
  const SPECIES_PER_PAGE = 9;

  const initSpeciesFilters = () => {
    const root = document.querySelector('[data-species-root]');

    if (!(root instanceof HTMLElement) || root.dataset.speciesBound === 'true') {
      return;
    }

    root.dataset.speciesBound = 'true';

    const searchField = document.querySelector('[data-species-search]');
    const familyField = document.querySelector('[data-species-family]');
    const cards = Array.from(root.querySelectorAll('[data-species-card]'));
    const emptyState = root.querySelector('[data-species-empty]');
    const pagination = document.querySelector('[data-species-pagination]');
    const pageStatus = pagination?.querySelector('[data-species-page-status]');
    const pageList = pagination?.querySelector('[data-species-page-list]');
    const previousButton = pagination?.querySelector('[data-species-page-prev]');
    const nextButton = pagination?.querySelector('[data-species-page-next]');

    let currentPage = 1;

    const setButtonState = (button: Element | null | undefined, isDisabled: boolean) => {
      if (button instanceof HTMLButtonElement) {
        button.disabled = isDisabled;
      }
    };

    const renderPageButtons = (totalPages: number) => {
      if (!(pageList instanceof HTMLElement)) {
        return;
      }

      pageList.innerHTML = '';

      Array.from({ length: totalPages }, (_, index) => index + 1).forEach((page) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.speciesPageButton = page.toString();
        button.textContent = page.toString();
        button.className =
          page === currentPage
            ? 'rounded-full bg-primary px-3 py-1.5 font-semibold text-white transition'
            : 'rounded-full border border-slate-200 px-3 py-1.5 font-semibold text-slate-600 transition hover:border-primary hover:text-primary';
        button.setAttribute('aria-current', page === currentPage ? 'page' : 'false');
        button.addEventListener('click', () => {
          currentPage = page;
          applyFilters();
        });

        pageList.append(button);
      });
    };

    const applyFilters = () => {
      const query =
        searchField instanceof HTMLInputElement ? searchField.value.trim().toLowerCase() : '';
      const family = familyField instanceof HTMLSelectElement ? familyField.value : 'all';
      const matchingCards = cards.filter((card) => {
        if (!(card instanceof HTMLElement)) {
          return false;
        }

        const searchText = card.dataset.searchText ?? '';
        const cardFamily = card.dataset.family ?? '';

        return (!query || searchText.includes(query)) && (family === 'all' || cardFamily === family);
      });

      const totalPages = Math.max(1, Math.ceil(matchingCards.length / SPECIES_PER_PAGE));
      currentPage = Math.min(currentPage, totalPages);

      const pageStart = (currentPage - 1) * SPECIES_PER_PAGE;
      const pageEnd = pageStart + SPECIES_PER_PAGE;
      const visibleCards = new Set(matchingCards.slice(pageStart, pageEnd));

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) {
          return;
        }

        card.classList.toggle('hidden', !visibleCards.has(card));
      });

      if (emptyState instanceof HTMLElement) {
        emptyState.classList.toggle('hidden', matchingCards.length > 0);
      }

      if (pageStatus instanceof HTMLElement) {
        pageStatus.textContent =
          matchingCards.length > 0
            ? `Página ${currentPage} de ${totalPages}`
            : 'Sin resultados';
      }

      if (pagination instanceof HTMLElement) {
        pagination.classList.toggle('hidden', matchingCards.length === 0);
      }

      setButtonState(previousButton, currentPage <= 1);
      setButtonState(nextButton, currentPage >= totalPages);
      renderPageButtons(totalPages);
    };

    searchField?.addEventListener('input', () => {
      currentPage = 1;
      applyFilters();
    });
    familyField?.addEventListener('change', () => {
      currentPage = 1;
      applyFilters();
    });
    previousButton?.addEventListener('click', () => {
      currentPage -= 1;
      applyFilters();
    });
    nextButton?.addEventListener('click', () => {
      currentPage += 1;
      applyFilters();
    });
    applyFilters();
  };

  initSpeciesFilters();
  document.addEventListener('astro:page-load', initSpeciesFilters);
</script>
