---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Especies | Ecotec Flora Médica"
  description="Catálogo inicial de especies medicinales para ampliar el sitio en el futuro."
>
  <section class="mx-auto max-w-4xl px-6 pt-32 pb-16 lg:px-8">
    <p
      class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700"
    >
      Especies
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950">
      Catálogo de especies
    </h1>
    <p class="mt-4 text-lg leading-8 text-slate-700">
      Esta sección queda lista para incorporar fichas taxonómicas, usos
      tradicionales y advertencias de uso responsable.
    </p>
  </section>
</Layout>
